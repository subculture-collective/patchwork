            "state": "translated",
            "value": "Mapa"
          }
        }
      }
    },
    "resources.openDetailsFor": {
      "comment": "Accessible label for opening a public resource; name is the listing display name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details for %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalles de %1$@"
          }
        }
      }
    },
    "discovery.resultCount": {
      "comment": "Count of results after discovery filters; count is an integer, not a localized number string.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld result"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld results"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld resultado"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld resultados"
                }
              }
            }
          }
        }
      }
    },
    "dashboard.excerptPlaceCount": {
      "comment": "Number of public places within a selected-area distance. distance is already formatted using product distance units.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld public place within %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld public places within %2$@"
                }
              }
            }
          }
