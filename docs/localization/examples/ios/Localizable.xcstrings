    "app.title": {
      "comment": "Product name. Do not translate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patchwork"
          }
        }
      },
      "shouldTranslate": false
    },
