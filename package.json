{
    "name": "patchwork",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "services/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=22.15.0"
    },
    "scripts": {
        "dev:web": "npm run dev -w @patchwork/web",
        "dev:api": "API_DATA_SOURCE=postgres npm run dev -w @patchwork/api",
        "dev:api:postgres": "API_DATA_SOURCE=postgres npm run dev -w @patchwork/api",
        "dev:indexer": "npm run dev -w @patchwork/indexer",
        "dev:moderation": "npm run dev -w @patchwork/moderation-worker",
        "db:up": "docker compose -f docker-compose.postgres.yml up -d postgres",
        "db:down": "docker compose -f docker-compose.postgres.yml down",
        "db:migrate": "npm run db:migrate -w @patchwork/api",
        "db:seed": "npm run db:seed -w @patchwork/api",
        "db:seed:showcase": "npm run db:seed:showcase -w @patchwork/api",
        "build": "npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "npm run test --workspaces --if-present && npm run test:maps && npm run test:exact-location-absence",
        "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
        "test:e2e:redact": "node scripts/check-playwright-artifacts.mjs",
        "test:exact-location-absence": "node scripts/check-exact-location-absence.mjs",
        "capacity:probe": "tsx scripts/run-http-load-probe.ts",
        "capacity:staging:evaluate": "tsx scripts/evaluate-staging-capacity.ts",
        "test:maps": "bash scripts/fetch-us-pmtiles.test.sh && bash scripts/verify-us-pmtiles.test.sh",
        "test:operations": "bash scripts/verify-release-trust.test.sh && bash scripts/release-state.test.sh && bash scripts/replicate-independent-backup.test.sh && node scripts/check-sprint-traceability.mjs",
        "check": "npm run lint && npm run typecheck && npm run test && npm run test:operations"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.2.1",
        "@types/node": "22.19.12",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.1.4",
        "@vitest/coverage-v8": "4.1.10",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vite": "7.3.6",
        "vitest": "5.0.0",
        "zod": "3.25.76"
    },
    "dependencies": {
        "tsx": "4.23.1"
    },
    "overrides": {
        "nanoid": "3.3.18"
    },
    "license": "GPL-3.0-or-later"
}
