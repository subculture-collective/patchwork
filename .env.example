# Shared
NODE_ENV=development
LOG_LEVEL=info
ATPROTO_SERVICE_DID=did:example:patchwork
ATPROTO_PDS_URL=https://bsky.social
# Private/LAN PDS origin for signup
ATPROTO_ACCOUNT_PDS_URL=http://10.0.0.56:3043

# Web
VITE_APP_NAME=Patchwork
VITE_API_BASE_URL=http://localhost:4000
VITE_DATA_MODE=api

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated trusted proxy IPs/CIDRs for local development
API_TRUSTED_PROXIES=127.0.0.1
API_DATA_SOURCE=fixture
API_DATABASE_URL=postgresql://patchwork:change-me@localhost:5432/patchwork
API_MAX_PROJECTION_LAG_SECONDS=300
API_RETENTION_INTERVAL_SECONDS=3600
API_ATTACHMENT_INTERVAL_SECONDS=30
API_NOTIFICATION_INTERVAL_SECONDS=15
# Private attachment pipeline. The object endpoint and ClamAV service must not be
# exposed publicly. Generate a signing key with: openssl rand -base64 32
ATTACHMENT_OBJECT_ENDPOINT=http://localhost:9000
ATTACHMENT_OBJECT_ACCESS_KEY=patchwork-dev
ATTACHMENT_OBJECT_SECRET_KEY=patchwork-dev-secret-key
ATTACHMENT_OBJECT_BUCKET=patchwork-private-attachments
ATTACHMENT_SIGNING_KEY=
ATTACHMENT_CLAMD_HOST=127.0.0.1
ATTACHMENT_CLAMD_PORT=3310
NOTIFICATION_EMAIL_PROVIDER_URL=
NOTIFICATION_EMAIL_PROVIDER_TOKEN=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_VAPID_SUBJECT=mailto:security@example.com
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
NOTIFICATION_PROVIDER_WEBHOOK_TOKEN=
ATPROTO_OAUTH_CLIENT_ID=http://localhost:4000/oauth/client-metadata.json
ATPROTO_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/oauth/callback
# Generate with: openssl rand -base64 32
ATPROTO_SESSION_ENCRYPTION_KEY=

# Indexer
INDEXER_PORT=4100
INDEXER_FIREHOSE_URL=https://jetstream.us-east.bsky.network
INDEXER_JETSTREAM_VERSION=v2
INDEXER_PROJECTION_MODE=v2-live
# Required by Jetstream v2 archive replay; create it at
# https://bsky.network/account#api-keys-section-heading and store it as a deployment secret.
JETSTREAM_API_KEY=
# Used by the opt-in shadow rebuild worker.
INDEXER_V2_URL=https://jetstream.us-east.bsky.network

# Moderation worker
MODERATION_PORT=4200
MODERATION_WORKER_CONCURRENCY=2
MODERATION_RETENTION_INTERVAL_SECONDS=3600

# Docker deploy (patchwork.subcult.tv)
PATCHWORK_PUBLIC_ORIGIN=https://patchwork.subcult.tv
# Required by docker-compose.yml in production
API_TRUSTED_PROXIES=10.0.0.0/8

# Required by docker-compose.staging.yml in staging
STAGING_API_TRUSTED_PROXIES=10.0.0.0/8

# Required PMTiles artifact bind mounts for web containers
PATCHWORK_PM_TILES_DIRECTORY=/srv/data/patchwork-map
PATCHWORK_PM_TILES_FILENAME=us.<64hex>.pmtiles
VITE_MAP_TILE_URL=/tiles/${PATCHWORK_PM_TILES_FILENAME}
STAGING_PATCHWORK_PM_TILES_DIRECTORY=/srv/data/patchwork-map
STAGING_PATCHWORK_PM_TILES_FILENAME=us.<64hex>.pmtiles
STAGING_VITE_MAP_TILE_URL=/tiles/${STAGING_PATCHWORK_PM_TILES_FILENAME}

# Secrets — generate strong random values for production.
# docker-compose.yml will refuse to start without these.
PATCHWORK_POSTGRES_PASSWORD=change-me
PATCHWORK_ATTACHMENT_ACCESS_KEY=
PATCHWORK_ATTACHMENT_SECRET_KEY=
PATCHWORK_ATTACHMENT_SIGNING_KEY=
STAGING_PATCHWORK_ATTACHMENT_ACCESS_KEY=
STAGING_PATCHWORK_ATTACHMENT_SECRET_KEY=
STAGING_PATCHWORK_ATTACHMENT_SIGNING_KEY=
STAGING_NOTIFICATION_EMAIL_PROVIDER_URL=
STAGING_NOTIFICATION_EMAIL_PROVIDER_TOKEN=
STAGING_NOTIFICATION_EMAIL_FROM=
STAGING_NOTIFICATION_VAPID_SUBJECT=mailto:security@example.com
STAGING_NOTIFICATION_VAPID_PUBLIC_KEY=
STAGING_NOTIFICATION_VAPID_PRIVATE_KEY=
STAGING_NOTIFICATION_PROVIDER_WEBHOOK_TOKEN=
