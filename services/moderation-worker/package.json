{
    "name": "@patchwork/moderation-worker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "npm run typecheck",
        "start": "tsx src/index.ts",
        "db:migrate": "tsx src/migrate.ts",
        "lint": "npm run typecheck",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node ../../scripts/test.mjs unit services/moderation-worker/src",
        "test:integration:postgres": "node ../../scripts/test.mjs postgres services/moderation-worker/src"
    },
    "dependencies": {
        "@patchwork/shared": "0.1.0",
        "pg": "^8.19.0"
    },
    "devDependencies": {
        "@types/pg": "^8.16.0"
    }
}
