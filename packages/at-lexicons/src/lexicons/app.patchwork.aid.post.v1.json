{
    "lexicon": 1,
    "id": "app.patchwork.aid.post",
    "revision": "2.0.0",
    "description": "Aid request/offer post record.",
    "defs": {
        "main": {
            "type": "record",
            "key": "tid",
            "record": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "$type",
                    "version",
                    "title",
                    "description",
                    "category",
                    "urgency",
                    "status",
                    "location",
                    "createdAt"
                ],
                "properties": {
                    "$type": {
                        "type": "string",
                        "const": "app.patchwork.aid.post"
                    },
                    "version": {
                        "type": "string",
                        "enum": [
                            "1.0.0",
                            "2.0.0"
                        ]
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 140
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 5000
                    },
                    "category": {
                        "type": "string"
                    },
                    "urgency": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "location": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [],
                        "properties": {
                            "latitudeE6": {
                                "type": "integer",
                                "minimum": -90000000,
                                "maximum": 90000000
                            },
                            "longitudeE6": {
                                "type": "integer",
                                "minimum": -180000000,
                                "maximum": 180000000
                            },
                            "precisionMeters": {
                                "type": "integer",
                                "minimum": 1000,
                                "maximum": 50000
                            },
                            "areaLabel": {
                                "type": "string",
                                "maxLength": 120
                            },
                            "countryCode": {
                                "type": "string",
                                "const": "US"
                            },
                            "postalCode": {
                                "type": "string",
                                "minLength": 5,
                                "maxLength": 5
                            }
                        },
                        "description": "Version 2.0.0 requires countryCode and postalCode only. Coordinate fields are legacy version 1.0.0 read compatibility; application validation enforces version-specific fields."
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "datetime"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "datetime"
                    }
                }
            }
        }
    }
}
